# Config du projet Firebase pour la synchronisation multi-appareils
# (Firestore). Copie ce fichier en .env.local et renseigne les valeurs
# depuis les réglages de ton projet Firebase (Project settings → General
# → Your apps). Optionnel : sans ces valeurs, l'appli fonctionne
# normalement en local uniquement (pas de synchronisation).
# Ce ne sont pas des secrets à proprement parler (elles identifient le
# projet, l'accès est contrôlé par les règles Firestore), mais les passer
# en secrets GitHub évite de les committer en clair — voir le README.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
